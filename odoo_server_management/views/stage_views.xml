<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stage_form" model="ir.ui.view">
        <field name="name">server.stage.form</field>
        <field name="model">server.stage</field>
        <field name="arch" type="xml">
            <form string="Stage" js_class="server_mgmt_form">
                <header>
                    <!-- Per-user action gates (per-stage grants on the Access page);
                         each button hides when the current user lacks that action. -->
                    <field name="client_stage" invisible="1"/>
                    <field name="can_pull" invisible="1"/>
                    <field name="can_backup" invisible="1"/>
                    <field name="can_upgrade" invisible="1"/>
                    <field name="can_control" invisible="1"/>
                    <field name="host_backup_category" invisible="1"/>
                    <field name="odoo_status_live" nolabel="1" readonly="1" style="font-weight: bold;"/>
                    <button name="action_check_status_now" type="object" string="Check Status"
                            class="btn-secondary" icon="fa-refresh"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': [('op_state', '=', 'running')]}"/>

                    <button name="action_upgrade_module" string="Upgrade Module" type="object"
                            class="btn-primary" icon="fa-refresh"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': ['|', ('can_upgrade', '=', False), ('op_state', '=', 'running')]}"/>

                    <button name="action_view_logs_stream" type="object" string="View Logs"
                            class="btn-primary" icon="fa-terminal"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': [('op_state', '=', 'running')]}"/>

                    <button name="action_view_conf_file" type="object" string="View Conf File"
                            class="btn btn-primary" icon="fa-file-text"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': [('op_state', '=', 'running')]}"/>

                    <button name="action_pull_code" type="object" string="Pull Code"
                            class="btn btn-primary" icon="fa-download"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': ['|', ('can_pull', '=', False), ('op_state', '=', 'running')]}"/>

                    <button name="action_start_service" type="object" string="Start"
                            class="btn btn-success" icon="fa-play"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': ['|', ('can_control', '=', False), ('op_state', '=', 'running')]}"/>

                    <button name="action_stop_service" type="object" string="Stop"
                            class="btn btn-danger" icon="fa-stop"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': ['|', ('can_control', '=', False), ('op_state', '=', 'running')]}"/>

                    <button name="action_restart_service" type="object" string="Restart"
                            class="btn btn-warning" icon="fa-refresh"
                            groups="odoo_server_management.group_user"
                            attrs="{'invisible': ['|', ('can_control', '=', False), ('op_state', '=', 'running')]}"/>

                    <!-- Permanently remove a broken/old/unused instance: the record
                         plus (optionally) its service/nginx/database on the server.
                         Administrator only. -->
                    <button name="action_delete_instance" type="object"
                            string="Delete Instance" class="btn-danger" icon="fa-trash"
                            groups="odoo_server_management.group_admin"
                            attrs="{'invisible': [('op_state', '=', 'running')]}"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="client_stage" widget="boolean_toggle"
                               groups="odoo_server_management.group_devops"/>
                        <field name="notes"/>
                    </group>
                    <group string="Last Operation" attrs="{'invisible': [('op_state', '=', False)]}">
                        <group>
                            <field name="op_label" readonly="1"/>
                            <field name="op_state" readonly="1"/>
                            <field name="op_time" readonly="1"/>
                        </group>
                        <field name="op_detail" readonly="1" nolabel="1" colspan="2"
                               attrs="{'invisible': [('op_detail', '=', False)]}"
                               placeholder="Operation log / output…"/>
                    </group>
                    <notebook>
                        <page string="General Info" groups="odoo_server_management.group_devops">
                            <group>
                                <group>
                                    <field name="host_id"/>
                                    <field name="service_name" readonly="1"/>
                                    <field name="odoo_version"/>
                                    <field name="needs_review"/>
                                    <field name="domain_review_needed"/>
                                    <field name="last_backup"/>
                                    <field name="auto_stop"/>
                                </group>
                                <group>
                                    <field name="log_file_path"/>
                                    <field name="upgrade_module_path"/>
                                    <field name="conf_file"/>
                                    <field name="nginx_file"/>
                                    <field name="odoo_bin"/>
                                    <field name="python_bin"/>
                                </group>
                            </group>
                            <field name="backup_review_needed" invisible="1"/>
                            <div class="alert alert-danger" role="alert"
                                 attrs="{'invisible': [('backup_review_needed', '=', False)]}">
                                <strong>🔴 No daily backup for this instance.</strong>
                                <field name="backup_review_reason" readonly="1" nolabel="1"
                                       attrs="{'invisible': [('backup_review_reason', '=', False)]}"/>
                            </div>
                            <div class="alert alert-warning" role="alert"
                                 attrs="{'invisible': [('needs_review', '=', False)]}">
                                <strong>⚠ Needs review:</strong>
                                <field name="review_reason" readonly="1" nolabel="1"
                                       attrs="{'invisible': [('review_reason', '=', False)]}"/>
                            </div>
                            <field name="domain_missing" invisible="1"/>
                            <div class="alert alert-info" role="alert"
                                 attrs="{'invisible': [('domain_missing', '=', False)]}">
                                <strong>🌐 This instance has no domain.</strong>
                                It is reached by <b>&lt;ip&gt;:&lt;port&gt;</b>. Give it a domain
                                by adding a <b>server_name</b> to its nginx site on the server,
                                then run <b>Discover</b> again so the instance works correctly —
                                its daily backup then moves under a folder named after the domain.
                            </div>
                            <div class="alert alert-info" role="alert"
                                 attrs="{'invisible': [('overridden_fields', '=', False)]}">
                                <strong>🔒 Manual overrides active.</strong>
                                Discovery will not overwrite the field(s) you edited:
                                <field name="overridden_fields" readonly="1" nolabel="1"/>
                                <button name="action_resume_discovery_sync" type="object"
                                        string="Resume Auto-Sync" class="btn-link"
                                        icon="fa-refresh"
                                        confirm="Let discovery manage every field on this instance again? Your manual edits will be refreshed from the server on the next Discover."/>
                            </div>
                        </page>

                        <page string="Access Info" groups="odoo_server_management.group_devops">
                            <group>
                                <group string="Odoo Service Secret">
                                    <field name="admin_password" password="True"/>
                                </group>
                                <group string="Odoo Access">
                                    <field name="odoo_user" password="True"/>
                                </group>
                            </group>
                        </page>

                        <page string="Branch Configuration">
                            <button name="action_refresh_commits" type="object"
                                    string="Get Commit" class="btn-secondary"
                                    icon="fa-refresh"
                                    groups="odoo_server_management.group_user"/>
                            <field name="repo_branch_paths">
                                <tree default_order="repository_id">
                                    <field name="repository_id"/>
                                    <field name="branch_id"/>
                                    <field name="current_commit_short" string="Commit"/>
                                    <field name="commit_subject" string="Message"/>
                                    <field name="commit_date" string="Commit Date" optional="show"/>
                                    <field name="commit_author" string="Author" optional="hide"/>
                                    <field name="current_commit" string="Full SHA" optional="hide"/>
                                    <field name="commit_checked" string="Checked" optional="show"/>
                                </tree>
                            </field>
                            <div class="text-muted" style="font-size:12px;">
                                The commit each repository checkout is currently on,
                                per branch. Filled during <b>Discover</b>, refreshed
                                daily, and on demand via <b>Get Commit</b>.
                            </div>
                        </page>
                        <page string="Backups">
                            <button name="action_refresh_backups" type="object"
                                    string="Refresh List" class="btn-primary"
                                    icon="fa-refresh"
                                    groups="odoo_server_management.group_user"/>
                            <!-- On-demand live backup. Kept here (not in the header) so
                                 downloading an existing daily backup below is the first,
                                 resource-cheap choice; take a fresh one only when needed. -->
                            <button name="action_backup_database" type="object"
                                    string="Full Backup (with Filestore)" class="btn-secondary"
                                    icon="fa-database"
                                    groups="odoo_server_management.group_user"
                                    attrs="{'invisible': ['|', ('can_backup', '=', False), ('op_state', '=', 'running')]}"/>
                            <!-- Database-only variant: a plain pg_dump, no filestore.
                                 Much smaller and quicker when the attachments aren't
                                 needed (schema inspection, a dev refresh, a support
                                 copy). Same dialog, pre-set to the SQL format. -->
                            <button name="action_backup_database_sql" type="object"
                                    string="Database Only (dump.sql)" class="btn-secondary"
                                    icon="fa-file-code-o"
                                    groups="odoo_server_management.group_user"
                                    attrs="{'invisible': ['|', ('can_backup', '=', False), ('op_state', '=', 'running')]}"/>
                            <field name="backup_file_ids" readonly="1" nolabel="1">
                                <tree string="Stored Backups" create="false" edit="false"
                                      delete="false" editable="false"
                                      default_order="db asc, last_modified desc">
                                    <field name="is_client" invisible="1"/>
                                    <field name="db" string="Database"/>
                                    <field name="last_modified" string="Created"/>
                                    <field name="size_human" string="Size"/>
                                    <field name="filename" string="File" optional="hide"/>
                                    <button name="action_download" type="object"
                                            string="Download" icon="fa-download" class="btn-link"/>
                                </tree>
                            </field>
                            <div class="text-muted" style="font-size:12px;">
                                Daily backups for this stage, grouped by database and newest
                                first (several days are kept per database). Click
                                <b>Refresh List</b>, then <b>Download</b> the day you need — this
                                is the recommended way, it reuses a backup already taken (no load
                                on the server). Use <b>Full Backup (with Filestore)</b> only when
                                you need an up-to-the-minute copy; it dumps the live database on
                                the server. <b>Database Only (dump.sql)</b> is the same dump
                                without the filestore — smaller and faster, but attachments are
                                not included.
                                Download gives a temporary link. For <b>Client Server</b> stages,
                                only Tech Leads, Operators and Admins — or a Developer granted
                                access on the <b>Access</b> page — may download or back up.
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_stage_tree" model="ir.ui.view">
        <field name="name">server.stage.tree</field>
        <field name="model">server.stage</field>
        <field name="arch" type="xml">
            <tree string="Stages" js_class="server_stage_list"
                  decoration-danger="backup_review_needed or backup_overdue"
                  decoration-info="(domain_review_needed or domain_missing) and not backup_review_needed and not backup_overdue"
                  decoration-warning="needs_review and not domain_review_needed and not domain_missing and not backup_review_needed and not backup_overdue">
                <field name="name"/>
                <field name="host_id" groups="odoo_server_management.group_devops"/>
                <field name="odoo_version"/>
                <field name="odoo_status"/>
                <field name="last_backup" string="Last Daily Backup"/>
                <field name="backup_review_needed" string="Backup Missing" readonly="1"/>
                <field name="domain_missing" string="No Domain" readonly="1"/>
                <field name="domain_review_needed" string="Domain Review" readonly="1"/>
                <field name="needs_review" readonly="1"/>
                <field name="client_stage" widget="boolean_toggle" readonly="1"
                       groups="odoo_server_management.group_devops"/>
                <!-- loaded for the row decoration only -->
                <field name="backup_overdue" invisible="1"/>
                <button name="action_check_status" type="object"
                        string="Check Status" icon="fa-refresh"
                        groups="odoo_server_management.group_user"/>
                <button name="action_delete_instance" type="object"
                        string="Delete Instance" icon="fa-trash"
                        groups="odoo_server_management.group_admin"/>
            </tree>
        </field>
    </record>

    <record id="view_stage_search" model="ir.ui.view">
        <field name="name">server.stage.search</field>
        <field name="model">server.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="host_id" string="Server"/>
                <filter string="Running" name="running" domain="[('odoo_status', '=', 'running')]"/>
                <filter string="Stopped" name="stopped" domain="[('odoo_status', '=', 'stopped')]"/>
                <separator/>
                <filter string="Missed Daily Backup" name="backup_overdue" domain="[('backup_overdue', '=', True)]"/>
                <filter string="Backup Missing" name="backup_missing" domain="[('backup_review_needed', '=', True)]"/>
                <filter string="No Domain" name="domain_missing" domain="[('domain_missing', '=', True)]"/>
                <filter string="Domain Needs Review" name="domain_review" domain="[('domain_review_needed', '=', True)]"/>
                <filter string="Needs Review" name="needs_review" domain="[('needs_review', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter string="Server" name="group_by_host" context="{'group_by': 'host_id'}"/>
                    <filter string="Odoo Version" name="group_by_version" context="{'group_by': 'odoo_version'}"/>
                    <filter string="Status" name="group_by_status" context="{'group_by': 'odoo_status'}"/>
                </group>
                <!-- Left-hand clickable panel to filter instances by server. -->
                <searchpanel>
                    <field name="host_id" string="Server" icon="fa-server" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">server.stage</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_host': 1}</field>
    </record>

    <menuitem id="menu_stages" name="Stages" parent="menu_server_management"
              action="action_stage" sequence="20"
              groups="odoo_server_management.group_user"/>
</odoo>
