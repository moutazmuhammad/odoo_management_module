#!/bin/bash
# ============================================================================
# Odoo self-backup agent (shell) — runs from local cron, as root.
#
# This is the SHELL replacement for the Python agent (agent.py). It does the
# same job — back up EVERY exposed database of EVERY stage on this server to the
# shared object store — but uploads with `s3cmd` using S3 credentials baked in
# here (rendered per-host by the manager's deploy_agent.yml), instead of asking
# the manager for pre-signed URLs on every run. Fewer moving parts = fewer ways
# for a nightly run to silently stall.
#
# Flow:
#   1. Fetch the authoritative db list from the manager (/server_backup/agent/dblist,
#      auth by source IP) -> EVERY database of EVERY stage, with its path segment
#      (nginx domain, else ip:port). Falls back to local smart_backup.py detect only
#      if the manager is unreachable (local auto-detect can resolve 0 DBs on some
#      remote-PG / dbfilter hosts, which the manager list never does).
#   2. For each db: smart_backup.py dumpfile -> a LOCAL Odoo-format zip via a
#      direct pg_dump (NOT /web/database/backup, which saves a corrupt HTML zip
#      when its own pg_dump fails), validate it, then `s3cmd put` to
#          <prefix>/<category>/<server>/<domain-or-ip:port>/<db>/<db>_<date>.zip
#   3. Prune each db folder by AGE — delete backups older than the retention
#      window (days), always keeping the newest. The window is the manager's
#      current "Retention (days)" setting (fetched at run time), so a change to it
#      takes effect on the next run without a redeploy.
#
# EVERYTHING below the CONFIG block is rendered verbatim — only the values in
# CONFIG are templated, so the logic stays identical across hosts.
# ============================================================================
set -u
export LC_ALL=C

# ------------------------------ CONFIG (templated) --------------------------
ACCESS_KEY="{{ backup_access_key }}"
SECRET_KEY="{{ backup_secret_key }}"
HOST_BASE="{{ backup_host_base }}"          # e.g. fra1.digitaloceanspaces.com
BUCKET="{{ backup_bucket }}"
PREFIX="{{ backup_prefix | default('') }}"  # optional global key prefix
CATEGORY="{{ backup_category | default('odex') }}"
SERVER_SEG="{{ backup_server_seg }}"        # slug of this server's name
HOST_IP="{{ backup_host_ip }}"              # manager-known public IP
RETENTION_DAYS={{ keep | default(7) }}      # delete backups older than N days (per db);
                                            # a runtime value from the manager overrides this
EXTRA_DBS="{{ extra_dbs | default('') }}"   # additive comma list of db names
MANAGER_URL="{{ manager_url | default('') }}"   # manager base URL (authoritative db list)
HOST_HEADER="{{ host_header | default('') }}"   # vhost Host header for the manager
AGENT_DIR="/opt/odoo-backup"
WORK_DIR="/var/tmp/odoo-backup-work"
S3CFG="/etc/odoo-backup.s3cfg"
# ----------------------------------------------------------------------------

log() { echo "backup-agent: $*"; }

install_dependencies() {
    for dep in s3cmd unzip python3; do
        if ! command -v "$dep" >/dev/null 2>&1; then
            log "installing missing dependency: $dep"
            apt-get update -qq && apt-get install -y "$dep" >/dev/null 2>&1 \
                || { log "ERROR could not install $dep"; return 1; }
        fi
    done
}

write_s3cfg() {
    # Root-only S3 config so the key never leaks to other users on the box.
    umask 077
    cat > "$S3CFG" <<EOF
[default]
access_key = ${ACCESS_KEY}
secret_key = ${SECRET_KEY}
host_base = ${HOST_BASE}
host_bucket = %(bucket)s.${HOST_BASE}
use_https = True
signature_v2 = False
EOF
    chmod 600 "$S3CFG"
}

s3() { s3cmd -c "$S3CFG" "$@"; }

# Normalize an ip/domain path segment the SAME way the manager does
# (server_host._backup_host_seg): lowercase; unsafe chars -> '-'; collapse
# repeated '.'/'-'; strip edge '.'/'-' (guards against '..' traversal).
host_seg() {
    local s
    s=$(echo "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9._-]+/-/g')
    s=$(echo "$s" | sed -E 's/-{2,}/-/g; s/\.{2,}/./g')
    echo "$s" | sed -E 's/^[.-]+//; s/[.-]+$//'
}

# Join non-empty parts with '/', dropping a leading/trailing slash on each.
join_key() {
    local out="" p
    for p in "$@"; do
        p=$(echo "$p" | sed -E 's#^/+##; s#/+$##')
        [ -z "$p" ] && continue
        [ -z "$out" ] && out="$p" || out="$out/$p"
    done
    echo "$out"
}

# Delete backups older than RETENTION_DAYS under an s3 db-folder, but ALWAYS keep
# the single newest (so a database that stops being backed up never loses its last
# copy — the same floor the manager's _prune uses). Age comes from the YYYY-MM-DD
# embedded in each key (<db>_<date>.zip), so it is timezone-proof and needs no
# object-metadata lookups. RETENTION_DAYS<=0 disables pruning (keep everything).
cleanup_old_backups() {
    local folder="$1" files f d e age today_epoch newest_e=0 newest_f=""
    [ "${RETENTION_DAYS:-0}" -le 0 ] 2>/dev/null && return 0
    files=$(s3 ls "$folder" | awk '{print $NF}' | grep -E '\.zip$' || true)
    [ -z "$files" ] && return 0
    today_epoch=$(date -u +%s)
    # Pass 1: find the newest backup (by embedded date) — always kept.
    while read -r f; do
        [ -z "$f" ] && continue
        d=$(echo "$f" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -n1)
        [ -z "$d" ] && continue
        e=$(date -u -d "$d" +%s 2>/dev/null) || continue
        [ "$e" -gt "$newest_e" ] && { newest_e=$e; newest_f=$f; }
    done <<< "$files"
    # Pass 2: delete anything older than the window, except that newest one.
    while read -r f; do
        [ -z "$f" ] && continue
        [ "$f" = "$newest_f" ] && continue
        d=$(echo "$f" | grep -oE '[0-9]{4}-[0-9]{2}-[0-9]{2}' | tail -n1)
        [ -z "$d" ] && continue
        e=$(date -u -d "$d" +%s 2>/dev/null) || continue
        age=$(( (today_epoch - e) / 86400 ))
        if [ "$age" -gt "$RETENTION_DAYS" ]; then
            s3 del "$f" >/dev/null 2>&1 \
                && log "pruned $(basename "$f") (${age}d old > ${RETENTION_DAYS}d)" \
                || log "failed to delete $f"
        fi
    done <<< "$files"
}

# The authoritative list of databases to back up: EVERY database of EVERY stage
# on this host, with its path segment (nginx domain, else ip:port). Fetched from
# the manager (same source the old agent used) so nothing is silently missed —
# local auto-detect can resolve 0 DBs on some hosts (remote-PG / dbfilter setups),
# which is why we prefer the manager list and only FALL BACK to local detect when
# the manager can't be reached. Prints a json list [{db,domain,port},...].
fetch_targets() {
    local resp js force_b64 line
    if [ -n "$MANAGER_URL" ]; then
        # --post30x keeps the POST across the manager's http->https 301 redirect
        # (nginx by-IP vhost). -k tolerates an old CA bundle on the http->https hop;
        # the manager authenticates us by source IP and only returns a db list.
        resp=$(curl -sS -k -L --post301 --post302 --post303 --max-time 60 \
                 -H "Content-Type: application/json" \
                 ${HOST_HEADER:+-H "Host: $HOST_HEADER"} \
                 -d '{"jsonrpc":"2.0","method":"call","params":{}}' \
                 "$MANAGER_URL/server_backup/agent/dblist" 2>/dev/null)
        js=$(printf '%s' "$resp" | python3 -c '
import json,sys
try:
    t=(json.load(sys.stdin).get("result") or {}).get("targets") or []
    if t: print(json.dumps(t))
except Exception: pass' 2>/dev/null)
        # The current "Retention (days)" setting travels with the list, so a change
        # to it applies on the NEXT run (no redeploy) — overrides the baked default.
        local rt
        rt=$(printf '%s' "$resp" | python3 -c '
import json,sys
try:
    v=(json.load(sys.stdin).get("result") or {}).get("retention_days")
    print(int(v) if v not in (None,"",False) else "")
except Exception: pass' 2>/dev/null)
        # fetch_targets runs in a command-substitution subshell, so hand the value
        # to the parent via a file (a plain var assignment here would be lost).
        [ -n "$rt" ] && echo "$rt" > "$WORK_DIR/.retention" 2>/dev/null
        if [ -n "$js" ]; then echo "$js"; return 0; fi
        log "manager dblist unavailable/empty; falling back to local detect"
    fi
    # Fallback: local auto-detect (+ EXTRA_DBS forced by name).
    if [ -n "$EXTRA_DBS" ]; then
        force_b64=$(python3 -c 'import base64,json,sys; print(base64.b64encode(json.dumps([x.strip() for x in sys.argv[1].replace("\n",",").split(",") if x.strip()]).encode()).decode())' "$EXTRA_DBS")
    fi
    line=$(python3 "$AGENT_DIR/smart_backup.py" detect "${force_b64:-}" 2>>/var/log/odoo-backup.log \
             | grep '^ODOO_BACKUP_DETECT:' | head -n1)
    [ -z "$line" ] && { echo '[]'; return; }
    echo "${line#ODOO_BACKUP_DETECT:}" | base64 -d
}

backup_all() {
    local day targets n ok db domain port seg keyfolder key zip
    day=$(date +%Y-%m-%d)
    # Start clean: wipe any leftover from a previous run that was hard-killed
    # (OOM / reboot / timeout) BEFORE its EXIT trap could fire, so a stale zip is
    # never left sitting on the managed server.
    rm -rf "$WORK_DIR"
    mkdir -p "$WORK_DIR"; chmod 700 "$WORK_DIR"
    # Keep smart_backup.py's own scratch (any pg_dump spool) UNDER the dir we wipe,
    # so nothing it writes can be left behind either.
    export ODOO_BACKUP_TMPDIR="$WORK_DIR"

    # 1. Authoritative database list (manager first, local detect fallback).
    #    fetch_targets also drops the manager's current retention window in
    #    .retention — pick it up so a setting change applies without a redeploy.
    rm -f "$WORK_DIR/.retention"
    targets=$(fetch_targets)
    [ -s "$WORK_DIR/.retention" ] && RETENTION_DAYS=$(cat "$WORK_DIR/.retention")
    n=$(echo "$targets" | python3 -c 'import json,sys
try: print(len(json.load(sys.stdin)))
except Exception: print(0)')
    if [ "$n" -eq 0 ]; then log "no databases to back up"; return 0; fi

    # 2. Back up each database independently — one failure never stops the rest.
    ok=0
    local i=0 fields
    while [ "$i" -lt "$n" ]; do
        # Pull the i-th target's fields, ONE PER LINE (not tab-separated: `read`
        # coalesces consecutive tabs, which would drop an empty domain and shift
        # the port into it). mapfile keeps empty lines, so fields stay aligned.
        mapfile -t fields < <(echo "$targets" | python3 -c '
import json,sys
t=json.load(sys.stdin)[int(sys.argv[1])]
print(t.get("db",""))
print(t.get("domain",""))
print(t.get("port",""))
' "$i")
        db="${fields[0]:-}"; domain="${fields[1]:-}"; port="${fields[2]:-}"
        i=$((i + 1))
        [ -z "$db" ] && continue

        # Path segment: nginx domain, else <ip>:<port> (or ip). Matches the
        # manager's server_host._instance_seg exactly.
        if [ -n "$domain" ]; then
            seg=$(host_seg "$domain")
        elif [ -n "$port" ]; then
            seg=$(host_seg "${HOST_IP}:${port}")
        else
            seg=$(host_seg "$HOST_IP")
        fi

        zip="$WORK_DIR/${db}.zip"
        rm -f "$zip"
        if ! python3 "$AGENT_DIR/smart_backup.py" dumpfile "$db" "$zip" \
                >>/var/log/odoo-backup.log 2>&1; then
            log "$db FAILED (dump)"; rm -f "$zip"; continue
        fi
        if ! unzip -t "$zip" >/dev/null 2>&1; then
            log "$db FAILED (invalid zip)"; rm -f "$zip"; continue
        fi

        keyfolder=$(join_key "$PREFIX" "$CATEGORY" "$SERVER_SEG" "$seg" "$db")
        key="${keyfolder}/${db}_${day}.zip"
        if s3 put "$zip" "s3://${BUCKET}/${key}" >/dev/null 2>&1; then
            log "$db uploaded"
            ok=$((ok + 1))
            cleanup_old_backups "s3://${BUCKET}/${keyfolder}/"
        else
            log "$db FAILED (upload)"
        fi
        rm -f "$zip"
    done

    log "$ok/$n uploaded"

    # Tell the manager we're done so it reconciles last_backup against the bucket
    # and the Servers/Instances list turns green immediately (the s3cmd upload never
    # touches the manager, so without this the record stays red until the 08:00
    # verify cron). Best-effort: the backups are already safe in the bucket.
    if [ "$ok" -gt 0 ] && [ -n "$MANAGER_URL" ]; then
        curl -sS -k -L --post301 --post302 --post303 --max-time 60 \
             -H "Content-Type: application/json" \
             ${HOST_HEADER:+-H "Host: $HOST_HEADER"} \
             -d '{"jsonrpc":"2.0","method":"call","params":{}}' \
             "$MANAGER_URL/server_backup/agent/report" >/dev/null 2>&1 \
             && log "reported completion to manager" \
             || log "manager report failed (backups are safe in the bucket)"
    fi
}

main() {
    # NEVER leave a backup on the managed server: this EXIT trap wipes the work dir
    # on ANY exit — success, per-DB error, or a caught signal (INT/TERM). A hard
    # SIGKILL/power-loss can't run a trap, so backup_all ALSO wipes it at start.
    trap 'rm -rf "$WORK_DIR"' EXIT INT TERM
    install_dependencies || exit 1
    write_s3cfg
    backup_all
}

main "$@"
