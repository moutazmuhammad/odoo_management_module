<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_category_project_roles" model="ir.module.category">
        <field name="name">Server Management</field>
        <field name="description">Access levels for the Server Management module</field>
    </record>

    <!-- Developer: act on instances subject to the per-user, per-stage grants on
         the 'Access' page. Normal instances are actionable by default; Client
         Server instances are read-only until granted. No servers, no settings,
         no secrets. -->
    <record id="group_user" model="res.groups">
        <field name="name">Developer</field>
        <field name="category_id" ref="group_category_project_roles"/>
    </record>

    <!-- DevOps: everything EXCEPT the General Settings menu — manage Servers
         (create), run Discover Instances, Install Self-Backup Agent, manage the
         per-user Access page, all server buttons (Test Connection, Check Status,
         Terminal, Run Backup Now), all stage pages, repository management.
         DevOps bypasses the per-stage grants (every action on every stage).
         DevOps is a superset of Developer. -->
    <record id="group_devops" model="res.groups">
        <field name="name">DevOps</field>
        <field name="category_id" ref="group_category_project_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_user'))]"/>
    </record>

    <!-- Administrator: DevOps + the global General Settings. -->
    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="group_category_project_roles"/>
        <field name="implied_ids" eval="[(4, ref('group_devops'))]"/>
    </record>

    <!-- Record rules: Developers READ every stage by default (they see the
         instance + its logs), EXCEPT any stage on which their own grant row sets
         View OFF (user.stage_denied_ids). The model ACL keeps them read-only and
         the per-action grants gate the action buttons. Servers themselves stay
         visible only to DevOps/Admins, who see all of them and bypass the grants. -->
    <record id="rule_host_devops_all" model="ir.rule">
        <field name="name">Servers: DevOps see all</field>
        <field name="model_id" ref="model_server_host"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_devops'))]"/>
    </record>

    <record id="rule_stage_developer" model="ir.rule">
        <field name="name">Stages: Developers read all except View-denied</field>
        <field name="model_id" ref="model_server_stage"/>
        <field name="domain_force">[('id', 'not in', user.stage_denied_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_user'))]"/>
    </record>
    <record id="rule_stage_devops_all" model="ir.rule">
        <field name="name">Stages: DevOps see all</field>
        <field name="model_id" ref="model_server_stage"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_devops'))]"/>
    </record>

</odoo>
